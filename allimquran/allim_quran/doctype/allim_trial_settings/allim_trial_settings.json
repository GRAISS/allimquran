      "fieldtype": "Check",
      "default": "0",
      "description": "Enable only after testing the outgoing email account. Staff notification preferences apply separately."
    }
  ],
  "field_order": [
    "coordinator",
    "response_hours",
    "email_enabled"
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1
    }
  ]
}
