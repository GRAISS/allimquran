{
  "doctype": "DocType",
  "name": "ALLIM Trial Settings",
  "module": "ALLIM Quran",
  "custom": 0,
  "issingle": 1,
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "coordinator",
      "label": "Default trial coordinator",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "response_hours",
      "label": "First contact deadline in hours",
      "fieldtype": "Int",
